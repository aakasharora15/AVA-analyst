# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project Settings -> Environment Variables.

# --- Front end (bundled into the browser; public values only) ---------------
# mock = in-browser demo data (default). live = Supabase + the AVA API.
VITE_AVA_DATA=mock
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Leave empty on Vercel (the API is served from the same domain under /api).
VITE_API_URL=
# Optional services. Each stays off, and nothing extra loads, until set.
# Cloudflare Turnstile site key (bot check on the free audit). Pair with TURNSTILE_SECRET_KEY.
VITE_TURNSTILE_SITE_KEY=
# Sentry DSN for browser errors (the same DSN as SENTRY_DSN is fine).
VITE_SENTRY_DSN=

# --- API (server only; never prefix with VITE_) ------------------------------
# Supabase -> Project Settings -> Database -> Connection string (transaction pooler, port 6543).
DATABASE_URL=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Legacy JWT secret. Leave empty if the project uses asymmetric signing keys;
# the API then verifies tokens against the project's JWKS endpoint.
SUPABASE_JWT_SECRET=
ANTHROPIC_API_KEY=
# Vercel sends this as a Bearer token to scheduled jobs. Use a long random string.
CRON_SECRET=
APP_URL=https://YOUR-DOMAIN
EMAIL_FROM=AVA <alerts@YOUR-DOMAIN>
RESEND_API_KEY=
# Receives drift warnings and holds.
AVA_DRIFT_OWNER_EMAIL=
# Receives operations alerts: failed audits, data-room folders to purge after a deletion.
AVA_OPS_EMAIL=
# AVA team members who verify Enterprise metrics at /ava-review (comma-separated; each needs two-factor on).
AVA_STAFF_EMAILS=
# Optional: lets account deletion remove data-room files directly (Supabase -> Project Settings -> API keys -> secret key).
SUPABASE_SERVICE_ROLE_KEY=

# --- Billing (Stripe). Off until all are set ----------------------------------
STRIPE_SECRET_KEY=
# From the webhook endpoint https://YOUR-DOMAIN/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...) for each self-serve plan.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_MAX=

# --- Abuse protection and monitoring -----------------------------------------
TURNSTILE_SECRET_KEY=
# Free audits per network address per day, and in total per day.
AVA_FREE_AUDITS_PER_IP_DAY=2
AVA_FREE_AUDITS_PER_DAY=50
SENTRY_DSN=

# --- Model and prompts (pinned; change only with a calibration run) ----------
# Standard engine for every plan, and the Deep audit model (Pro Max, Enterprise).
# Both stay internal: users never see which model ran.
AVA_MODEL=claude-sonnet-5-5
AVA_DEEP_MODEL=claude-opus-5-5
AVA_EFFORT=high
AVA_PROMPT_VERSION=prompts-2026.10
# default = Anthropic's server-side refusal fallback, requested only for models that support it; off = never.
AVA_REFUSAL_FALLBACK=default
